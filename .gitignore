.venv/

# Python cache
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Data (raw downloads can be large; keep them out of Git)
data/raw/
# Processed tables can be rebuilt with src/build_records.py
data/processed/*.parquet
# External reference data (e.g. Natural Earth outlines), downloaded automatically when missing
data/external/

# Secrets (API keys, account details)
.env

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
